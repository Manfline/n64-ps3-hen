/*
 * Salsa64 — CRT con cable, filtro original del autor portado de su versión
 * de RetroMac (v1.1). Pasada «decodifica»: la tele en cada muestra de cada
 * línea. Suma CRT_TAPS muestras de la señal con pesos fijos (ya
 * normalizados): luma por un pasa bajos gaussiano y color por un filtro RC
 * de 2 polos que solo «recuerda» lo que ya pasó (la estela a la derecha),
 * promediado sobre ciclos completos (pasa banda); con RGB, el mismo pasa
 * bajos en cada canal. Después a RGB, a luz lineal (gamma 2,4) y la
 * saturación del tubo.
 *   we[i], wo[i] = pesos de las muestras jlo + 2i y jlo + 2i + 1: (luma,
 *   color, color); wz, el de la última si son impares
 *   k0 = (jlo + 0,5, gamma de entrada, saturación)
 *   m0, m1, m2 = filas de YIQ → RGB (identidad con RGB)
 */
void main(float4 pos : TEXCOORD0, uniform sampler2D sig : TEXUNIT0, uniform float4 we[CRT_TAPS / 2],
	  uniform float4 wo[CRT_TAPS / 2], uniform float4 wz, uniform float4 k0,
	  uniform float4 m0, uniform float4 m1, uniform float4 m2, out float4 color : COLOR)
{
	/* Las coordenadas de dos muestras en un registro: una suma por par. */
	float4 b = float4(floor(pos.x) + k0.x, pos.y, floor(pos.x) + k0.x + 1.0, pos.y);
	float3 s = 0.0;
	for (int i = 0; i < CRT_TAPS / 2; i++) {
		float4 c = b + float4(2 * i, 0.0, 2 * i, 0.0);
		s += tex2D(sig, c.xy).rgb * we[i].xyz + tex2D(sig, c.zw).rgb * wo[i].xyz;
	}
#if CRT_TAPS & 1
	s += tex2D(sig, b.xy + float2(CRT_TAPS - 1, 0.0)).rgb * wz.xyz;
#endif
	float3 rgb = float3(dot(s, m0.xyz), dot(s, m1.xyz), dot(s, m2.xyz));
	float3 lin = pow(max(rgb, 0.0), k0.yyy);
	float lum = dot(lin, float3(0.2126, 0.7152, 0.0722));
	color = float4(max(lerp(lum.xxx, lin, k0.z), 0.0), 0.0);
}
