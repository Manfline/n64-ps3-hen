/* Referencia para test_fpgen.c: textura × textura, T0·T1·X0 + X1. */
void main(float4 uv : TEXCOORD0, float4 x0 : TEXCOORD1, float4 x1 : TEXCOORD2,
	uniform sampler2D tex0 : TEXUNIT0, uniform sampler2D tex1 : TEXUNIT1, out float4 color : COLOR)
{
	float4 t0 = tex2D(tex0, uv.xy);
	float4 t1 = tex2D(tex1, uv.zw);
	color = saturate(t0 * t1 * x0 + x1);
}
